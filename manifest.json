{
  "manifest_version": 3,
  "name": "Nuan",
  "version": "0.1.1",
  "version_name": "0.1.1.alpha.2",
  "description": "Reclaim the present by limiting active social media browsing time.",
  "permissions": ["alarms", "idle", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "src/ui/popup/popup.html",
    "default_title": "Nuan"
  },
  "options_page": "src/ui/options/options.html"
}
